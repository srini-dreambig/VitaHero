# VitaHero Android build configuration
# Add these keys to android/local.properties (gitignored) or set as environment variables.

sdk.dir=C\:\\path\\to\\Android\\Sdk

# Cloudflare Worker backend (required)
RORK_FUNCTIONS_URL=https://kidhero-health-backend.rork.app

# Neon Auth / Google sign-in (required for OAuth)
GOOGLE_WEB_CLIENT_ID=

# Optional Rork project metadata
RORK_API_BASE_URL=
RORK_AUTH_URL=
PROJECT_ID=
TEAM_ID=

# AI diet tips: configure TOOLKIT_URL + TOOLKIT_SECRET_KEY on the Cloudflare Worker
# (see functions/.dev.vars.example). The Android app calls POST /api/ai-diet-tips/generate.
