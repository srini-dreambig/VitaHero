# VitaHero Android build configuration
#
# Put these in android/local.properties, which is gitignored, or set them as
# environment variables. Either works: build.gradle.kts checks the environment,
# then local.properties, then -P project properties.

sdk.dir=C\:\\path\\to\\Android\\Sdk

# Where the app sends every request, and the host the App Link verifies
# against. Both come from this one value. Unset, it defaults to the production
# worker, so a build with no configuration at all still points somewhere real.
VITAHERO_BACKEND_URL=https://vitahero.kallam.workers.dev

# Release signing. All four, or the release build is unsigned.
VITAHERO_KEYSTORE=/path/to/upload-key.jks
VITAHERO_KEYSTORE_PASSWORD=
VITAHERO_KEY_ALIAS=
VITAHERO_KEY_PASSWORD=

# Sign-in needs no configuration here. It is Firebase phone OTP, and its
# settings come from android/app/google-services.json — but the SHA-1 and
# SHA-256 of every signing key (upload, Play app-signing, debug) must be
# registered in the Firebase console, or no code is ever sent.

# AI diet tips are a worker-side feature: set TOOLKIT_URL and
# TOOLKIT_SECRET_KEY on the Cloudflare worker, not here. See
# functions/.dev.vars.example. The app just calls POST /api/ai-diet-tips/generate.
