<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and above. Same reasoning as backup_rules.xml.

  device-transfer is excluded as well as cloud-backup: a direct phone-to-phone
  transfer moves the encrypted prefs without the Keystore key behind them, so
  it fails in exactly the same way.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vitahero_session.xml" />
        <exclude domain="sharedpref" path="vitahero_sync_queue.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vitahero_session.xml" />
        <exclude domain="sharedpref" path="vitahero_sync_queue.xml" />
    </device-transfer>
</data-extraction-rules>
