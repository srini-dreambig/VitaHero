# VitaHero environment variables
#
# Nothing here is a secret — it is the shape of the configuration. Real values
# go in android/local.properties, in the Cloudflare worker's secrets, or in CI
# secrets, none of which are tracked.

# ─────────────────────────────────────────────────────────────
# Android build (android/local.properties, a -P flag, or CI env)
# ─────────────────────────────────────────────────────────────

# Where the app sends every request. build.gradle.kts also derives the App Link
# host in the manifest from this, so the two can never disagree. Left unset it
# defaults to the production worker below.
VITAHERO_BACKEND_URL=https://vitahero.kallam.workers.dev

# Release signing. With none of these set the release build is unsigned, which
# fails at upload rather than quietly producing something that looks signed.
VITAHERO_KEYSTORE=
VITAHERO_KEYSTORE_PASSWORD=
VITAHERO_KEY_ALIAS=
VITAHERO_KEY_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Cloudflare Worker secrets (wrangler secret put, or functions/.dev.vars)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=
ADMIN_API_KEY=
INVITE_SIGNING_KEY=

# SMS. One provider, either Twilio or textbee.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional. An OpenAI-compatible chat endpoint for AI diet tips and the remote
# half of food recognition. Both features return null and degrade quietly when
# these are unset, so leaving them blank costs nothing. Note the request path
# is currently the shape the original vendor used — pointing this at a
# different provider means changing the path in functions/index.ts too.
TOOLKIT_URL=
TOOLKIT_SECRET_KEY=
