rules_version = '2';

// VitaHero Firestore Security Rules
//
// Data model:
//   profiles/{uid}                      — parent profile (owner-only)
//   profiles/{uid}/kids/{kidId}         — children (owner write, authenticated read for doctor/leaderboard flows)
//   profiles/{uid}/kids/{kidId}/growth_points — owner-only
//   profiles/{uid}/kids/{kidId}/ai_diet_tips  — owner-only
//   profiles/{uid}/meals                — owner-only
//   profiles/{uid}/streaks              — owner write, authenticated read (leaderboard)
//   profiles/{uid}/appointments         — owner-only
//   profiles/{uid}/co_parents           — owner-only
//   profiles/{uid}/notifications        — owner-only
//   profiles/{uid}/camps                — owner-only
//
//   health_checkups/{id}                — parent reads own (user_id match), doctors write; authenticated read
//   school_enrollments/{id}             — owner write, authenticated read (doctor camp flow)
//   camp_registrations/{id}             — owner write, authenticated read (doctor camp flow)
//   schools, school_camps, hospitals, doctors — authenticated read (public directory)
//
//   provisioned_parents, doctor_assignments, import_batches, sms_log — admin-only (Worker service account)

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Parent profiles — owner only ──
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Kids: owner can write; any authenticated user can read (doctor camp flow + leaderboard)
      match /kids/{kidId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;

        // Growth points: owner only
        match /growth_points/{gpId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
        // AI diet tips: owner only
        match /ai_diet_tips/{tipId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      // Meals: owner only
      match /meals/{mealId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Streaks: owner can write; any authenticated user can read (leaderboard)
      match /streaks/{streakId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Appointments: owner only
      match /appointments/{aptId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Co-parents: owner only
      match /co_parents/{cpId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Notifications: owner only
      match /notifications/{notifId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Parent-created camps: owner only
      match /camps/{campId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Health checkups — parent reads own (user_id match); doctors create/update ──
    match /health_checkups/{checkupId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // ── School enrollments — owner write, authenticated read (doctor camp flow) ──
    match /school_enrollments/{enrollmentId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == request.resource.data.user_id;
    }

    // ── Camp registrations — owner write, authenticated read (doctor camp flow) ──
    match /camp_registrations/{regId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == request.resource.data.user_id;
    }

    // ── Public directories — authenticated read only ──
    match /schools/{schoolId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /school_camps/{campId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /hospitals/{hospId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /doctors/{doctorId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Admin-only collections — no direct client access (Worker uses service account) ──
    match /provisioned_parents/{phone} {
      allow read, write: if false;
    }
    match /doctor_assignments/{assignmentId} {
      allow read, write: if false;
    }
    match /import_batches/{batchId} {
      allow read, write: if false;
    }
    match /sms_log/{logId} {
      allow read, write: if false;
    }

    // ── Deny everything else ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
