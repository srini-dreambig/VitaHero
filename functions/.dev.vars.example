# Cloudflare Worker secrets (set in Rork dashboard or `wrangler secret put`)
# Copy to functions/.dev.vars for local worker testing — never commit real values.

DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Rork Toolkit — used server-side for AI diet tips (NOT in the Android app)
TOOLKIT_URL=https://toolkit.rork.app
TOOLKIT_SECRET_KEY=

# Closed-app admin import + invites
# ADMIN_API_KEY doubles as a one-time admin credential for the web portal
# (paste it into the portal's "Admin API Key" tab) and lets you create admin
# accounts via POST /api/auth/signup with the X-Admin-Key header.
ADMIN_API_KEY=
# HMAC key used to sign stateless invite tokens (keep separate from ADMIN_API_KEY).
INVITE_SIGNING_KEY=
# Android App Links: comma-separated SHA-256 signing-cert fingerprints.
ANDROID_CERT_SHA256=
# Optional Play Store URL used as the install fallback on the invite landing page.
APP_PLAY_URL=

# ─── VitaHero Console ─────────────────────────────────────────
# Served by this worker at  https://<worker-host>/admin
#
# First-time setup:
#   1. Set ADMIN_API_KEY above and deploy.
#   2. Open /admin and sign in with that key ("Ops key" tab).
#   3. Give yourself a phone login so you stop pasting the key:
#      curl -X POST https://<worker-host>/api/admin/ops/grant \
#        -H "X-Admin-Key: $ADMIN_API_KEY" -H "Content-Type: application/json" \
#        -d '{"phone":"9876543210","name":"Your Name"}'
#
# Running a camp, end to end:
#   1. Add a school and the checks it has agreed to (Programme).
#   2. Set its classes and sections.
#   3. Upload the student roster (CSV).
#   4. Add people: an administrator, screeners, and a supervising physician.
#      They all sign in at /admin with their mobile number and an OTP.
#   5. Schedule a camp: date, checks, which classes.
#   6. Build the list of children  <-- without this the camp has nobody on it
#      and a screener signing in sees an empty list.
#   7. Assign screeners and a physician to that camp.
#   8. Request consent by SMS. Paper forms can be recorded in the console.
#   9. Camp day: the screening team records findings per child.
#  10. The physician reviews every child and approves.
#  11. Release. Only then do guardians see anything in the app.
