# Cloudflare Worker secrets (set in Rork dashboard or `wrangler secret put`)
# Copy to functions/.dev.vars for local worker testing — never commit real values.

DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

# Rork Toolkit — used server-side for AI diet tips (NOT in the Android app)
TOOLKIT_URL=https://toolkit.rork.app
TOOLKIT_SECRET_KEY=

# Closed-app admin import + invites
# ADMIN_API_KEY doubles as the login credential for the web admin portal
# (visit https://kidhero-health-backend.rork.app/admin and paste this key).
# It also lets you create admin accounts via POST /api/auth/signup with
# the X-Admin-Key header.
ADMIN_API_KEY=
# HMAC key used to sign stateless invite tokens (keep separate from ADMIN_API_KEY).
INVITE_SIGNING_KEY=
# Android App Links: comma-separated SHA-256 signing-cert fingerprints.
ANDROID_CERT_SHA256=
# Play Store URL used as the "Get the app" download link on the invite landing page.
# Defaults to the internal test track link below; override once the app is in production.
APP_PLAY_URL=https://play.google.com/apps/internaltest/4700990678853594044

# Invite links are texted to the parent automatically via Twilio the moment
# the admin clicks Invite (single, bulk, or right after an import). If Twilio
# isn't configured yet, the link is still generated and shown in the admin
# panel so you can copy/share it manually as a fallback.
# Login OTP is handled entirely by Firebase Phone Auth on the client, so no
# SMS provider is needed for that.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio phone number (or Messaging Service "from" number) invites are sent from.
TWILIO_FROM_NUMBER=

# ── DEV MODE (testing only) ───────────────────────────────────
# Set DEV_MODE=true to decode Firebase ID tokens without signature
# verification, for local/dev testing of authenticated endpoints.
# NEVER enable in production.
DEV_MODE=
